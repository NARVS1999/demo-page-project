# ─────────────────────────────────────────────────────────────────────────────
# nextjs-starter — environment contract (9 canonical vars)
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres — get BOTH from Neon Console → Connect modal:
# DATABASE_URL         = toggle "Connection pooling" ON  (URL contains `-pooler`) — app runtime
# DATABASE_URL_DIRECT  = toggle "Connection pooling" OFF (no `-pooler`)          — migrations/seed
DATABASE_URL=postgresql://user:pass@ep-XXXX-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:pass@ep-XXXX.us-east-2.aws.neon.tech/dbname?sslmode=require

# Auth — generate with: openssl rand -base64 32  (must be >= 32 chars)
SESSION_SECRET=replace-with-32+byte-secret

# Mock switches (default "mock"; "real" reserved for future apps)
MOCK_PAYMENT=mock
MOCK_EMAIL=mock
MOCK_SMS=mock
MOCK_OAUTH=mock
MOCK_MAPS=mock
MOCK_STORAGE=mock

# Vercel Blob — ONLY required when MOCK_STORAGE=real (real image uploads).
# Create a Blob store in Vercel → Storage → Blob → copy the read-write token.
BLOB_READ_WRITE_TOKEN=
